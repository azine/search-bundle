<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <parameter key="ewz_search.lucene.search.class">EWZ\Bundle\SearchBundle\Lucene\LuceneSearch</parameter>
        <parameter key="ewz_search.lucene.index.manager.class">EWZ\Bundle\SearchBundle\Lucene\LuceneIndexManager</parameter>
    </parameters>

    <services>
        <service id="ewz_search.lucene.manager"
                 class="%ewz_search.lucene.index.manager.class%"
                 public="true">
            <argument>%lucene.indices%</argument>
            <argument>%ewz_search.lucene.search.class%</argument>
        </service>

        <!-- Original single-index service kept as a supported backwards-compatible API. -->
        <service id="ewz_search.lucene"
                 class="%ewz_search.lucene.search.class%"
                 public="true">
            <argument>%lucene.index.path%</argument>
            <argument>%lucene.analyzer%</argument>
        </service>
    </services>
</container>
