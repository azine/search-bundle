{
    "name": "excelwebzone/search-bundle",
    "description": "Integrates the maintained Zend Search Lucene fork into Symfony applications.",
    "keywords": [
        "full-text search",
        "lucene",
        "symfony"
    ],
    "homepage": "https://github.com/azine/search-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael H. Arieli",
            "email": "excelwebzone@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/azine/zend-search"
        }
    ],
    "require": {
        "php": "^8.5",
        "excelwebzone/zend-search": "^2.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/expression-language": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "EWZ\\Bundle\\SearchBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EWZ\\Tests\\Bundle\\SearchBundle\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
